	<PropertyGroup>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<Nullable>disable</Nullable>
	</PropertyGroup>

	<Target Name="RemoveBundledS1Mapi" AfterTargets="Build">
		<Delete Files="$(OutputPath)S1MAPI_Mono.dll" ContinueOnError="true" />
		<Delete Files="$(OutputPath)S1MAPI_Il2Cpp.dll" ContinueOnError="true" />
	</Target>

	<!-- MelonAssemblyResolver looks for S1MAPI.dll, not S1MAPI_Mono.dll -->
	<Target Name="EnsureS1MapiUserLib" AfterTargets="Build" Condition="'$(Configuration)'=='Mono' Or '$(Configuration)'=='CrossCompat'">
		<Copy SourceFiles="$(S1MAPIMonoPath)" DestinationFiles="$(GamePath)\UserLibs\S1MAPI.dll" SkipUnchangedFiles="true" />
	</Target>

	<Target Name="EnsureS1MapiUserLibIl2Cpp" AfterTargets="Build" Condition="'$(Configuration)'=='Il2cpp'">
		<Copy SourceFiles="$(S1MAPIIl2CppPath)" DestinationFiles="$(GamePath)\UserLibs\S1MAPI.dll" SkipUnchangedFiles="true" />
	</Target>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="(tasklist | findstr /I &quot;Schedule.*I.exe&quot; &gt;nul &amp;&amp; taskkill /F /IM &quot;Schedule I.exe&quot; &amp;&amp; timeout /t 3 /nobreak &gt;nul) || echo Game not running&#xD;&#xA;for /L %%i in (1,1,5) do (COPY &quot;$(TargetPath)&quot; &quot;$(ModsPath)&quot; &amp;&amp; goto copied || timeout /t 1 /nobreak &gt;nul)&#xD;&#xA;:copied&#xD;&#xA;START &quot;&quot; &quot;$(GamePath)\Schedule I.exe&quot; --melonloader.launchdebugger --melonloader.debug" IgnoreExitCode="true" />
	</Target>
</Project>
