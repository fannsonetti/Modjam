<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>MoreWeapons</RootNamespace>
		<LangVersion>default</LangVersion>
		<NeutralLanguage>en-US</NeutralLanguage>
		<Configurations>Mono;Il2cpp;CrossCompat</Configurations>
		<NoWarn>$(NoWarn);MSB3277</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Il2cpp'">
		<TargetFramework>net6.0</TargetFramework>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'!='Il2cpp'">
		<TargetFramework>netstandard2.1</TargetFramework>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Mono'">
		<GamePath>D:\Schedule 1 Dependencies\Mono</GamePath>
		<ManagedPath>$(GamePath)\Schedule I_Data\Managed</ManagedPath>
		<MelonLoaderPath>$(GamePath)\MelonLoader\net35</MelonLoaderPath>
		<ModsPath>$(GamePath)\Mods</ModsPath>
		<DefineConstants>MONO</DefineConstants>
		<AssemblyName>MoreWeapons_mono</AssemblyName>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Il2cpp'">
		<GamePath>D:\Schedule 1 Dependencies\Il2cpp</GamePath>
		<ManagedPath>$(GamePath)\MelonLoader\Il2CppAssemblies</ManagedPath>
		<MelonLoaderPath>$(GamePath)\MelonLoader\net6</MelonLoaderPath>
		<ModsPath>$(GamePath)\Mods</ModsPath>
		<DefineConstants>IL2CPP</DefineConstants>
		<AssemblyName>MoreWeapons_il2cpp</AssemblyName>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='CrossCompat'">
		<GamePath>D:\Schedule 1 Dependencies\Mono</GamePath>
		<ManagedPath>$(GamePath)\Schedule I_Data\Managed</ManagedPath>
		<MelonLoaderPath>$(GamePath)\MelonLoader\net35</MelonLoaderPath>
		<ModsPath>$(GamePath)\Mods</ModsPath>
		<DefineConstants>CROSS_COMPAT</DefineConstants>
		<AssemblyName>MoreWeapons</AssemblyName>
	</PropertyGroup>

	<PropertyGroup>
		<UsePublicized>false</UsePublicized>
		<UseLocalS1API>true</UseLocalS1API>
		<S1APILocalPath>D:\Schedule 1 Dependencies\S1API\S1API.Mono.MelonLoader.dll</S1APILocalPath>
		<S1APIIl2CppPath>D:\Schedule 1 Dependencies\S1API\S1API.Il2Cpp.MelonLoader.dll</S1APIIl2CppPath>
		<S1MAPIMonoPath>D:\Schedule 1 Dependencies\S1MAPI\S1MAPI_Mono.dll</S1MAPIMonoPath>
		<S1MAPIIl2CppPath>D:\Schedule 1 Dependencies\S1MAPI\S1MAPI_Il2Cpp.dll</S1MAPIIl2CppPath>
		<!-- Runtime: MelonLoader resolves S1MAPI from the installed mod's UserLibs folder, not from this output. -->
	</PropertyGroup>

